# The font files are content-hashed — each is named after the first eight hex
# digits of its own sha256 (`src/fonts.css`) — so an immutable year is safe for
# them and only for them. A changed font is a changed URL, so a browser holding
# the old one cannot be holding the new one, and no cache here can serve a
# stale face to a returning visitor.
#
# The MIME type is stated rather than trusted: Pages sends
# `X-Content-Type-Options: nosniff`, and a font refused for its type fails
# silently. The page keeps its fall-back stack and nothing says why. The pattern
# matches `.woff2` and nothing else, so the two OFL texts beside them keep
# Cloudflare's own `text/plain` — a second `Content-Type` rule over the same path
# would be comma-joined onto this one, not override it.
#
# Task 11's worker precaches `/fonts/*.woff2` cache-first, which is only correct
# because of both lines above.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff2

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# The icons are the one immutable-looking thing here that is NOT content-hashed:
# `icon-192.png` keeps its name across a redesign (src/manifest.test.ts pins it),
# so an immutable year would hide a redrawn icon from every returning visitor for
# a year. `no-cache` costs three small revalidations per visit, and the worker's
# cache is what actually serves them afterwards.
/icons/*
  Cache-Control: no-cache

# The manifest is a claim about the app that a new deploy can contradict, and the
# home screen is built from it. It is revalidated like a document.
/manifest.webmanifest
  Cache-Control: no-cache

# The worker is the only file here that must never be served stale: a cached
# `sw.js` is an old set of caching rules held against the new build, on every
# device, until a hard refresh. `no-cache` still sends the body — it just makes
# the browser ask whether it is current, which is the update check.
/sw.js
  Cache-Control: no-cache